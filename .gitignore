# output, so it's intentionally not excluded here.
/vendor/build/*.tar.gz
/vendor/build/src/
/vendor/libcmark-gfm/

# scratch test scripts used during development, not part of the repo
/vendor/build/test*.php
/vendor/build/diff-test.php
/vendor/build/fence-test.php

